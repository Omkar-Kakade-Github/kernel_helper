set(stage_dir "@CMAKE_CURRENT_BINARY_DIR@/install-stage")
set(consumer_build_dir "@CMAKE_CURRENT_BINARY_DIR@/consumer-build")

execute_process(
  COMMAND
    "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@" --prefix "${stage_dir}"
  RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
  message(FATAL_ERROR "kernel_helper installation failed")
endif()

execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    -S "@CMAKE_CURRENT_SOURCE_DIR@/consumer"
    -B "${consumer_build_dir}"
    -DCMAKE_PREFIX_PATH=${stage_dir}
    -DCMAKE_CUDA_ARCHITECTURES=80
  RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
  message(FATAL_ERROR "consumer configuration failed")
endif()

execute_process(
  COMMAND "@CMAKE_COMMAND@" --build "${consumer_build_dir}"
  RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
  message(FATAL_ERROR "consumer build failed")
endif()

